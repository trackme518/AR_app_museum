# Public HTTPS entry point for this deployment (a domain name, never an IP).
# The deploy target is selected by the DNS A record for this name:
#   - Public VPS:  A record -> the server's public IP
#   - Museum LAN:  A record -> the server's LAN IP (e.g. 10.0.0.30)
# TLS certificates are issued by Let's Encrypt via DNS-01, so the server does
# not need to be reachable from the internet to obtain or renew them.
APP_HOSTNAME=arapp.museumofpragueai.com
ACME_EMAIL=you@example.com
# true: use Let's Encrypt's staging CA (untrusted certificates, no rate
# limits) for testing. Never leave true in production.
ACME_STAGING=false
# DNS provider used for automatic ACME DNS-01 challenges.
# To issue and RENEW the Let's Encrypt certificate for APP_HOSTNAME, Traefik
# must create a temporary _acme-challenge TXT record inside that domain's DNS
# zone. Only the DNS provider can write to the zone, so Traefik calls the
# provider's API with the credentials below. Certificates renew unattended
# about every 60 days; without API credentials ("manual") a person must add
# the TXT record by hand at every issuance and renewal.
# Any provider name supported by lego works (https://go-acme.github.io/lego/dns/):
# wedos, cloudflare, hetzner, powerdns, ...; "manual" = add the TXT record yourself.
LEGODNS_PROVIDER=wedos
# Credentials are provider-specific: each provider module in lego reads its
# own fixed variable names, listed at https://go-acme.github.io/lego/dns/ .
# Set the variables for the provider chosen above. Examples:
#   wedos      -> WEDOS_USERNAME + WEDOS_WAPI_PASSWORD (generate the WAPI
#                 password in the WEDOS administration and allow-list this
#                 server's public IP there)
#   cloudflare -> CF_DNS_API_TOKEN
#   hetzner    -> HETZNER_DNS_API_TOKEN
WEDOS_USERNAME=
WEDOS_WAPI_PASSWORD=
SHOW_ERRORS=false
DEFAULT_LOCALE=en-US
# Default UI language (labels, chat, language selectors). Overrides DEFAULT_LOCALE.
DEFAULT_LANGUAGE=cs-CZ
SUPPORTED_LOCALES="{\"de-DE\":\"Deutsch\",\"en-US\":\"English\",\"fr-FR\":\"Français\",\"cs-CZ\":\"Čeština\",\"es-ES\":\"Español\",\"pl-PL\":\"Polski\",\"sk-SK\":\"Slovenština\",\"it-IT\":\"Italiano\",\"ja-JP\":\"日本語\",\"ko-KR\":\"한국어\"}"
# true: retranslate every UI string, ignoring existing UI_translations.json entries.
FORCE_TRANSLATION=false

DB_HOST=mariadb
DB_PORT=3306

# Required by the official MariaDB container; the PHP application connects
# with the same MARIADB_USER/MARIADB_PASSWORD credentials.
# Generate strong values with: openssl rand -hex 24
MARIADB_DATABASE=ar_museum
MARIADB_USER=ar_museum
MARIADB_PASSWORD=replace-with-a-strong-password
MARIADB_ROOT_PASSWORD=replace-with-another-strong-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Chat: any OpenAI-compatible chat completions provider (LM Studio,
# OpenRouter, OpenAI, ...). The /v1/chat/completions path is appended
# automatically; set only the base URL.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_TOKEN=
AI_CHAT_MODEL=google/gemini-3.1-flash-lite

RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=50
RAG_RETRIEVAL_LIMIT=5
RAG_MAX_UPLOAD_BYTES=15728640
# Embeddings: any OpenAI-compatible /v1/embeddings provider (LM Studio,
# OpenRouter, OpenAI, ...). The path is appended automatically; set only the
# base URL. The model's vector dimension must match EMBEDDING_DIMENSION;
# stored vectors are model-specific, so re-upload knowledge documents after
# switching models. Example for OpenRouter:
#   EMBEDDING_MODEL=qwen/qwen3-embedding-4b
#   EMBEDDING_DIMENSION=2560
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# API token for the embedding endpoint. Empty falls back to AI_API_TOKEN
# (useful when chat and embeddings share one provider).
EMBEDDING_API_TOKEN=
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSION=1024

# Launchar WebXR runtime for iOS (third party: https://launchar.app).
# Register the app at launchar.app to obtain a key. Leave empty to disable the
# Launchar integration entirely.
LAUNCHAR_APP_KEY=
